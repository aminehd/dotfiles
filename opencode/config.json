{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugin": [
    "@tarquinen/opencode-dcp",
    "opencode-pty"
  ],
  "permission": {
    "*": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      "kubectl apply*": "ask",
      "kubectl delete*": "ask",
      "kubectl edit*": "ask",
      "kubectl scale*": "ask",
      "kubectl patch*": "ask",
      "helm install*": "ask",
      "helm upgrade*": "ask",
      "helm uninstall*": "ask",
      "git push*": "ask"
    },
    "webfetch": "allow",
    "external_directory": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "serena": {
      "type": "local",
      "command": ["serena", "start-mcp-server", "--context", "ide", "--project-from-cwd"],
      "enabled": false
    }
  }
}
